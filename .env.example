# --- Database ---
# Any Postgres works (Supabase, Neon, Railway). For quick local testing,
# switch prisma/schema.prisma's provider to "sqlite" and use file:./dev.db instead.
DATABASE_URL="postgresql://user:password@localhost:5432/ledgerline"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Claude API (invoice field extraction, runs on claude-haiku-4-5) ---
ANTHROPIC_API_KEY=""

# --- Contact section (public — never put secrets in a NEXT_PUBLIC_ var) ---
# If empty, the Contact section on the landing page shows "Support contact
# is currently being set up." instead of a fake/placeholder email.
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Create these as ONE-TIME Prices in the Stripe dashboard (not recurring),
# then paste their price IDs here.
STRIPE_PRICE_STARTER=""   # $10 for 100 credits
STRIPE_PRICE_PRO=""       # $25 for 500 credits
# The 500+ "custom" tier has no Stripe price — it routes to a mailto: link.
